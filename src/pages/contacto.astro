---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contactar - Jose María">
	<main class="flex flex-col gap-10 mt-8">
        
        <div class="flex flex-col gap-2">
            <a href="/" class="text-zinc-500 hover:text-zinc-200 transition-colors w-fit flex items-center gap-2 text-sm font-medium mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Volver
            </a>
            <h1 class="text-3xl font-bold text-zinc-100">Hablemos</h1>
            <p class="text-zinc-400">¿Tienes una idea o propuesta? Envíame un mensaje directo.</p>
        </div>

        <form class="flex flex-col gap-6">
            
            <div class="flex flex-col gap-2">
                <label for="nombre" class="text-sm font-medium text-zinc-300">Nombre</label>
                <input 
                    type="text" 
                    id="nombre" 
                    name="nombre" 
                    placeholder="Tu nombre"
                    class="w-full rounded-lg bg-zinc-900/50 border border-zinc-800 px-4 py-3 text-zinc-200 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500/50 transition-all"
                    required 
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-medium text-zinc-300">Email</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="tu@email.com"
                    class="w-full rounded-lg bg-zinc-900/50 border border-zinc-800 px-4 py-3 text-zinc-200 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500/50 transition-all"
                    required 
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="mensaje" class="text-sm font-medium text-zinc-300">Mensaje</label>
                <textarea 
                    id="mensaje" 
                    name="mensaje" 
                    rows="5" 
                    placeholder="Cuéntame sobre el proyecto..."
                    class="w-full rounded-lg bg-zinc-900/50 border border-zinc-800 px-4 py-3 text-zinc-200 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500/50 transition-all resize-none"
                ></textarea>
            </div>

            <button 
                type="submit"
                class="mt-2 w-full sm:w-fit px-8 py-3 rounded-lg bg-zinc-100 text-zinc-900 font-semibold hover:bg-white transition-colors"
            >
                Enviar Mensaje
            </button>
            
        </form>

        <div class="pt-8 border-t border-zinc-800/50 flex flex-col gap-4 text-sm text-zinc-500">
            <p>También puedes encontrarme en:</p>
            <div class="flex gap-4">
                <a href="#" class="hover:text-zinc-200 transition-colors">LinkedIn</a>
                <a href="https://github.com/Elion-hub" class="hover:text-zinc-200 transition-colors">GitHub</a>
            </div>
        </div>

	</main>
</Layout>