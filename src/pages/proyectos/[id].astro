---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { 
        params: { id: 'spring-architecture' }, 
        props: { 
            title: "Modular Config System", 
            desc: "Implementación técnica enfocada en patrones de diseño y desacoplamiento. El sistema permite alternar la persistencia de datos (Memoria vs JSON) dinámicamente mediante inyección de dependencias condicional (@ConditionalOnProperty).",
            img: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072", 
            stack: ["Java 17", "Spring Boot 3", "Design Patterns", "Clean Code"],
            github: "https://github.com/Elion-hub"
        } 
    },
    { 
        params: { id: 'javafx-task-manager' }, 
        props: { 
            title: "Task Manager FX", 
            desc: "Aplicación de escritorio moderna desarrollada con JavaFX y FXML para la interfaz de usuario, respaldada por un núcleo Spring Boot. Implementa una arquitectura en capas estricta (MVC) y persistencia robusta con Hibernate.",
            img: "https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?q=80&w=2072",
            stack: ["Java 17", "Spring Boot", "JavaFX", "Hibernate"],
            github: "https://github.com/Elion-hub"
        } 
    },
    { 
        params: { id: 'api-pokemon' }, 
        props: { 
            title: "Scalable Data API", 
            desc: "API RESTful optimizada para la gestión eficiente de entidades. Implementa operaciones de 'Bulk Insert' para cargas masivas de datos, filtrado dinámico mediante Query Parameters y un manejo robusto de excepciones HTTP.",
            img: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=2070",
            stack: ["Java 17", "Spring Boot", "JPA", "MySQL"],
            github: "https://github.com/Elion-hub"
        } 
    },
  ];
}

const { title, desc, img, stack, github } = Astro.props;
---

<Layout title={title}>
    <main class="flex flex-col gap-10 mt-8">
        
        <a href="/" class="text-zinc-500 hover:text-zinc-200 transition-colors w-fit flex items-center gap-2 text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver al inicio
        </a>

        <div class="flex flex-col gap-6 animate-fade-in-up">
            <h1 class="text-4xl font-bold text-zinc-100 tracking-tight">{title}</h1>
            
            <div class="flex flex-wrap gap-2">
                {stack.map((tech) => (
                    <span class="px-3 py-1 rounded-full bg-zinc-800/50 border border-zinc-700/50 text-xs text-zinc-300 font-medium">
                        {tech}
                    </span>
                ))}
            </div>
        </div>

        <div class="rounded-xl overflow-hidden border border-zinc-800 bg-zinc-900/50 aspect-video relative group">
            <div class="absolute inset-0 bg-zinc-900/20 group-hover:bg-transparent transition-colors"></div>
            <img src={img} alt={title} class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" transition:name={`image-${title}`} />
        </div>

        <div class="prose prose-invert prose-zinc max-w-none">
            <h3 class="text-xl font-semibold text-zinc-200 mb-4">Sobre el proyecto</h3>
            <p class="text-zinc-400 leading-relaxed text-lg">
                {desc}
            </p>
            
            <p class="text-zinc-400 leading-relaxed mt-4">
                Este proyecto fue diseñado siguiendo principios de Clean Architecture para asegurar su mantenibilidad. Se prestó especial atención a la gestión de errores y la optimización de consultas a base de datos.
            </p>
        </div>

        <div class="flex gap-4 pt-4 border-t border-zinc-800">
            <a href={github} target="_blank" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-100 text-zinc-900 font-medium text-sm hover:bg-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                Ver Código
            </a>
        </div>

    </main>
</Layout>