---
import { Github, Linkedin, Mail } from 'lucide-react';
---

<footer class="bg-[#0a0a0a] border-t border-white/10 py-12 relative z-10">
    {/* flex-col = Pone los elementos uno debajo de otro (Móvil)
       items-center = Centra todo horizontalmente (Móvil)
       md:flex-row = Pone los elementos en fila (Escritorio)
       md:justify-between = Los separa a los extremos (Escritorio)
    */}
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6">
        
        {/* Texto Copyright */}
        {/* text-center = Texto centrado (Móvil) | md:text-left = Texto a la izquierda (Escritorio) */}
        <div class="text-gray-500 text-sm text-center md:text-left">
            © {new Date().getFullYear()} Jose María García. <br class="block md:hidden"/>
        </div>

        {/* Redes Sociales y Correo */}
        <div class="flex items-center gap-6">
            <a 
                href="https://github.com/Elion-hub" 
                target="_blank" 
                aria-label="GitHub"
                class="text-gray-400 hover:text-white transition-colors hover:scale-110 transform duration-200"
            >
                <Github size={20} />
            </a>
            <a 
                href="https://www.linkedin.com/in/josem-garcia-" 
                target="_blank" 
                aria-label="LinkedIn"
                class="text-gray-400 hover:text-white transition-colors hover:scale-110 transform duration-200"
            >
                <Linkedin size={20} />
            </a>
            <a 
                href="mailto:josemgarcia.contacto@gmail.com" 
                aria-label="Email"
                class="text-gray-400 hover:text-white transition-colors hover:scale-110 transform duration-200"
            >
                <Mail size={20} />
            </a>
        </div>
    </div>
</footer>